    "esbuild": "~0.27.2",
    "eslint": "~9.39.2",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~17.0.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.1",
    "vitest": "^4.1.9"
